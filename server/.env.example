# Server environment — copy to server/.env and fill in.
# The server refuses to boot when a required variable is missing (it prints the list).

# --- required ---------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=change-me-to-a-long-random-string
# Changing ENCRYPTION_SECRET makes every stored account credential undecryptable.
ENCRYPTION_SECRET=change-me-to-a-long-random-string
OAUTH_STATE_SECRET=change-me-to-a-long-random-string
# Comma-separated list of browser origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000

# --- optional ---------------------------------------------------------------
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
# lax (default) works when client and API share a registrable domain.
COOKIE_SAMESITE=lax
HSTS_INCLUDE_SUBDOMAINS=false

# Google OAuth (needed for OTP mailbox linking)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5001/api/google-auth/otp/callback

# First admin, used by `npm run setup-admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=at-least-8-characters
ADMIN_USERNAME=admin

# OTP poller
OTP_FETCH_INTERVAL_MS=10000

# Optional Redis cache; falls back to in-process memory when unset.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

LOG_LEVEL=info
# Mounts the development harness (/api/dev) when NODE_ENV is not production.
DEV_TOOLS=true
